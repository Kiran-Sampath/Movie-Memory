# Copy this file to .env and fill in the blanks.

# Local Docker Postgres (docker compose up -d). Host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/moviememory?schema=public"

# Auth.js: signs cookies / CSRF tokens. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI (platform.openai.com > API keys). Server-side only.
OPENAI_API_KEY=""
# Optional: which model to use (defaults to gpt-4.1-mini)
# OPENAI_MODEL=""
