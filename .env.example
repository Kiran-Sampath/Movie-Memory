# Copy this file to .env and fill in the blanks.

# Local Docker Postgres (docker compose up -d). Host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/moviememory?schema=public"

# Auth.js: signs cookies / CSRF tokens. Generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI (platform.openai.com > API keys). Server-side only.
OPENAI_API_KEY=""
# Optional: which model to use (defaults to gpt-5.4-mini)
# OPENAI_MODEL=""

# Optional: movie suggestions while typing on the onboarding page.
# Free at themoviedb.org > Settings > API. Either the "API Read Access Token"
# (long) or the "API Key" (short, 32 characters) works.
# Leave empty and onboarding is a plain text input.
TMDB_API_TOKEN=""
